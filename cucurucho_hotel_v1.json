      "nombre": "Tension",
      "peso_global": 0.33,
      "descripcion": "Nivel de presión operativo-comercial percibido en el sistema."
    },
    "K": {
      "nombre": "Coherencia",
      "peso_global": 0.22,
      "descripcion": "Grado de alineación entre procesos, roles, canales y decisiones."
    },
    "R": {
      "nombre": "Resiliencia",
      "peso_global": 0.22,
      "descripcion": "Capacidad del sistema para absorber shocks sin colapsar."
    },
    "IT": {
      "nombre": "Indice_Telos",
      "peso_global": 0.23,
      "descripcion": "Alineación de la operación con el propósito declarado del sistema."
    }
