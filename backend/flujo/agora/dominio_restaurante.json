{
  "dominio": "restaurante_operacion",
  "_descripcion": "Restaurante. Triangula costo de insumos y personal contra la actividad real (cubiertos servidos, habitaciones-noche en hotel, etc.). El lado ingreso (ventas, ticket promedio) sería un segundo triplete con primaria=revenue.",
  "primaria": "servicio_restaurante",
  "triangulacion": "externa_dinero",
  "coordenada_compartida": {
    "_descripcion": "y = señal de compras (insumos, proveedores, sobreprecio, concentración, volumen). Importada con su gamma.",
    "senal_campo": "y_senal",
    "gamma_campo": "y_gamma",
    "gamma_default": 0.5
  },
  "nodos": {
    "cocina": {
      "tipo": "flujo",
      "rol": "consumo",
      "_descripcion": "Ancla infalsificable: consumo de insumos por cubierto servido. El caso del sous chef.",
      "observables": ["insumo_comprado", "cubiertos_servidos", "concentracion_proveedor", "horas_cocina", "merma_reportada"],
      "ancla": {
        "primitivo": "disonancia_vs_fisico",
        "params": {
          "reportado": "insumo_comprado",
          "fisico_obs": "cubiertos_servidos",
          "fisico_factor": 1.0,
          "orientacion": "reportado_excede",
          "div": 0.25,
          "peso": 0.8,
          "sec_obs": "concentracion_proveedor",
          "sec_peso": 0.2
        }
      },
      "avance": {
        "_descripcion": "cubiertos por hora-cocina (productividad de cocina)",
        "numerador": "cubiertos_servidos",
        "denominador": "horas_cocina"
      },
      "coordenada_y": {
        "senal_campo": "y_senal",
        "gamma_campo": "y_gamma",
        "gamma_default": 0.5
      }
    },
    "barra": {
