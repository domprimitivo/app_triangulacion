  },
  "geodesicas": {
    "catalogo": [
      {
        "id": "GM1_estabilizacion_basica",
        "descripcion": "Ruta prudencial para bajar T sin degradar R y manteniendo K en rango aceptable.",
        "aplicable_a": [
          "operacion",
          "canales",
          "finanzas"
        ],
        "prioridad": "media"
      },
      {
        "id": "GM2_refuerzo_resiliencia",
